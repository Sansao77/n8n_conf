N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
USER_LOCAL_DATA=/home/user/n8n_files # Local que o n8n pode acessar dados localmente
NODE_ENV=production
GENERIC_TIMEZONE=America/Sao_Paulo

# LocalTunnel (para referência)
LT_SUBDOMAIN=sansao-tunnel-n8n # Escolha um nome único
